# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Leave blank to run automatically in resilient in-memory mode
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/edusphere?retryWrites=true&w=majority

# Optional JDBC Database Configuration (for standalone Java/JSP service)
JDBC_DATABASE_URL=jdbc:h2:mem:academicdb;DB_CLOSE_DELAY=-1
JDBC_USER=sa
JDBC_PASS=
